{
    "id": "com.woltv.wakeonlan.service",
    "description": "Wake on LAN Service",
    "services": [
        {
            "name": "com.woltv.wakeonlan.service",
            "description": "Sends Wake-on-LAN magic packets and stores configuration",
            "commands": [
                {
                    "name": "wake",
                    "description": "Send a magic packet now",
                    "public": true
                },
                {
                    "name": "getConfig",
                    "description": "Return current configuration",
                    "public": true
                },
                {
                    "name": "setConfig",
                    "description": "Store configuration",
                    "public": true
                },
                {
                    "name": "getStatus",
                    "description": "Return last send status",
                    "public": true
                },
                {
                    "name": "getLog",
                    "description": "Return recent in-memory service log lines",
                    "public": true
                },
                {
                    "name": "setBootAuto",
                    "description": "Enable/disable the persistent boot auto-launch activity",
                    "public": true
                },
                {
                    "name": "scan",
                    "description": "Scan LAN and list discovered devices (ip + mac)",
                    "public": true
                }
            ]
        }
    ]
}
